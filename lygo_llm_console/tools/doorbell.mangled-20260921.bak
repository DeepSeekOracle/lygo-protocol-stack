def _state(root: Path, console: int, probe=None) -> dict:
    probe = probe or console_is_up
    up = False
    try:
        up = bool(probe(console))
    except Exception:
        up = False
    return {
        "doorbell": True,
        "console_port": int(console),
        "console_up": up,
        "launcher": LAUNCHER,
        "root": str(root),
        "last_boot": dict(_LAST),
        "cooldown_s": BOOT_COOLDOWN_S,
    }


def _cors(origin: str | None, console: int) -> dict:
    """Only this copy's own page may read a reply. Anything else gets no allow header at all."""
    allowed = (f"http://127.0.0.1:{console}", f"http://localhost:{console}")
    h = {"Access-Control-Allow-Methods": "GET, POST, OPTIONS",
         "Access-Control-Allow-Headers": "content-type",
         "Access-Control-Max-Age": "600"}
    if origin and origin in allowed:
        h["Access-Control-Allow-Origin"] = origin
        h["Vary"] = "Origin"
    return h


PAGE = """<!doctype html><meta charset="utf-8"><title>LYGO doorbell</title>
<style>body{font:14px/1.5 ui-monospace,Consolas,monospace;background:#0d1117;color:#e6edf3;margin:0;padding:28px}
b{color:#2f81f7}button{font:inherit;padding:10px 16px;border-radius:8px;border:1px solid #2f81f7;background:#12233d;color:#e6edf3;cursor:pointer}
button[disabled]{opacity:.6;cursor:default}.s{margin:14px 0;color:#8b949e}</style>
<h2>Δ9Φ963 · LYGO doorbell</h2>
<p class="s">The console server is not running. This doorbell is - it can start it for you.</p>
<p><button id="b">Boot the console</button></p>
<p class="s" id="m">console port <b id="p">?</b> \u00b7 this page will reload when it answers.</p>
<script>
async function up(){try{const r=await fetch("/state",{cache:"no-store"});return await r.json()}catch(e){return null}}
const TOKEN = "__DOORBELL_TOKEN__";
async function boot(){
  const b=document.getElementById("b"), m=document.getElementById("m");
  b.disabled=true; b.textContent="Ringing\u2026";
  try{ const j=await(await fetch("/state",{cache:"no-store"})).json();
       await fetch("/boot?token="+encodeURIComponent(j.token||TOKEN)+"&t="+Date.now(),{cache:"no-store"});
  }catch(e){}
  const t0=Date.now();
  while(Date.now()-t0<90000){
    await new Promise(r=>setTimeout(r,1500));
    const j=await up();
    if(j&&j.console_up){m.textContent="Up - taking you to the console\u2026";setTimeout(()=>{location.href="http://127.0.0.1:"+j.console_port+"/"},600);return}
    b.textContent="Starting\u2026 "+Math.round((Date.now()-t0)/1000)+"s";
  }
  b.disabled=false;b.textContent="Boot the console";
  m.textContent="It rang, but the console did not come up - check the launcher window.";
}
document.getElementById("b").addEventListener("click",boot);
up().then(j=>{if(j)document.getElementById("p").textContent=j.console_port});
</script>
"""


def handle(method: str, path: str, body: dict | None, *, root: Path | None = None,
           expected_token: str | None = None, console_port: int | None = None, spawn=None,
           probe=None, origin: str | None = None) -> tuple[int, dict, bytes]:
    """Pure request handling, so the rules can be tested without opening a socket."""
    root = root or ROOT
    console = int(console_port if console_port is not None else console_port_of(root))
    want = expected_token if expected_token is not None else token(root, create=True)
    url = urlparse(path)
    route = url.path
    query = parse_qs(url.query)
    headers = {"Content-Type": "application/json", **_cors(origin, console)}

    if method == "OPTIONS":
        return 204, headers, b""

    if route in ("/", "/index.html"):
        headers["Content-Type"] = "text/html; charset=utf-8"
        return 200, headers, PAGE.replace("__DOORBELL_TOKEN__", want).encode("utf-8")

    if route == "/state":
        return 200, headers, json.dumps(_state(root, console, probe)).encode("utf-8")

    if route == "/health":
        up = False
        try:
            up = bool((probe or console_is_up)(console))
        except Exception:
            up = False
        return 200, headers, json.dumps({"ok": True, "doorbell": True, "console_up": up}).encode("utf-8")

    if route == "/boot":
        given = ""
        if isinstance(body, dict):
            given = str(body.get("token") or "")
        if not given:
            given = str((query.get("token") or [""])[0])
        if not want or not secrets.compare_digest(given, want):
            return 403, headers, json.dumps({"ok": False, "error": "bad or missing token"}).encode("utf-8")
        # Anyone holding the token may ring, but a ring already honoured in the last few seconds is not
        # repeated: the launcher refuses a double start anyway, and this keeps a held-down button quiet.
        out = boot(root, spawn=spawn, respect_cooldown=(spawn is None), by=str(origin or ""))
        out["ok"] = bool(out.get("launched"))
        out["console_port"] = console
        return (200 if out["ok"] else 409), headers, json.dumps(out).encode("utf-8")

    return 404, headers, json.dumps({"ok": False, "error": "no such doorbell route"}).encode("utf-8")


def console_port_of(root: Path) -> int:
    return console_port(root)


class _Handler(BaseHTTPRequestHandler):
    server_version = "LYGODoorbell/1"
    sys_version = ""

 
 
 
 
