    def _run(self, method: str) -> None:
        parsed = urlparse(self.path)
        body = None
        if method == "POST":
            try:
                n = int(self.headers.get("Content-Length") or 0)
                raw = self.rfile.read(min(n, 8000)) if n else b""
                body = json.loads(raw.decode("utf-8") or "{}")
            except Exception:
                body = {}
        status, headers, payload = handle(
            method, self.path, body, root=self.server.root,  # type: ignore[attr-defined]
            console_port=self.server.console, origin=self.headers.get("Origin"),  # type: ignore[attr-defined]
        )
        if method == "POST" or parsed.path == "/boot":
            print(f"[doorbell] {method} {parsed.path} -> {status}", flush=True)
        self.send_response(status)
        for k, v in headers.items():
            self.send_header(k, v)
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        if payload:
            self.wfile.write(payload)

    def do_GET(self) -> None:
        self._run("GET")

    def do_POST(self) -> None:
        self._run("POST")

    def do_OPTIONS(self) -> None:
        self._run("OPTIONS")


def serve(root: Path | None = None, port: int | None = None) -> int:
    root = root or ROOT
    port = int(port if port is not None else doorbell_port(root))
    console = console_port_of(root)
    if not launcher_path(root).exists():
        print(f"[doorbell] no launcher at {launcher_path(root)} - refusing to listen", flush=True)
        return 2
    if console_is_up(port, timeout=0.3):
        print(f"[doorbell] {HOST}:{port} is already answered - one doorbell per copy", flush=True)
        return 0
    try:
        httpd = ThreadingHTTPServer((HOST, port), _Handler)
    except OSError as exc:
        print(f"[doorbell] cannot listen on {HOST}:{port} ({exc})", flush=True)
        return 3
    httpd.daemon_threads = True
    httpd.root = root        # type: ignore[attr-defined]
    httpd.console = console  # type: ignore[attr-defined]
    t = token(root, create=True)
    print(f"[doorbell] up on http://{HOST}:{port}/  \u00b7 console http://{HOST}:{console}/ "
    log_line(root, "up on %s:%d, console %d" % (HOST, port, console))
          f"\u00b7 token file {TOKEN_REL} ({len(t)} chars, never printed)", flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        httpd.server_close()
    return 0


def main(argv: list[str] | None = None) -> int:
 
 
 
 
