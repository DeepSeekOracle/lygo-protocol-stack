# Copy to .env (gitignored) or run: python tools/load_biophase7_vault.py
# Biophase7 restore vault: set LYGO_BIOPHASE7_VAULT to your 2026Biophase7 stack file or folder.

LYGO_BIOPHASE7_VAULT=

# Read order (Biophase7): NVIDIA → Google/Gemini → xAI alt → xAI main
NVIDIA_API_KEY=nvapi-REPLACE_ME
GOOGLE_API_KEY=AIzaREPLACE_ME
GEMINI_API_KEY=REPLACE_ME
XAI_API_KEY_ALT=xai-REPLACE_ME
XAI_API_KEY_MAIN=xai-REPLACE_ME
XAI_API_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Harness thresholds (optional)
LYGO_HARNESS_LATENCY_P4_MS=250
LYGO_HARNESS_PHI_P4_MIN=0.618
LYGO_HARNESS_CONSENSUS_DEV=0.35