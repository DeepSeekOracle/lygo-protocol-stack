{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepseekoracle.github.io/lygo-protocol-stack/schemas/agent_card.schema.json",
  "title": "LYGO Agent Lattice Card v1",
  "type": "object",
  "required": ["signature", "layer", "agent_id", "alignment_status", "digest"],
  "properties": {
    "signature": { "type": "string", "const": "Delta9Phi963-AGENT-CARD-v1" },
    "layer": { "type": "string", "const": "E" },
    "agent_id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "role": { "type": "string" },
    "alignment_status": {
      "type": "string",
      "enum": ["ALIGNED", "NEEDS_FIX", "UNKNOWN", "QUARANTINE"]
    },
    "lattice_roots": { "type": "object" },
    "skills": { "type": "array", "maxItems": 24 },
    "capabilities": { "type": "array", "maxItems": 32 },
    "expires_unix": { "type": "integer" },
    "digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "protection": { "type": "object" }
  }
}
