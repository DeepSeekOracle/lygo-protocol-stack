{
  "name": "@deepseekoracle/lygo-lattice-pulse",
  "version": "1.2.2",
  "description": "LYGO Lattice Pulse — live Haven heartbeat, stack verify, registry compare, star chart gate, alignment readiness",
  "type": "module",
  "license": "MIT-0",
  "dependencies": {
    "typebox": "1.1.39"
  },
  "openclaw": {
    "extensions": ["./src/index.ts"],
    "runtimeExtensions": ["./dist/index.js"],
    "install": {
      "clawhubSpec": "clawhub:@deepseekoracle/lygo-lattice-pulse",
      "npmSpec": "@deepseekoracle/lygo-lattice-pulse",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.6.11"
    },
    "compat": {
      "pluginApi": ">=2026.6.11",
      "minGatewayVersion": ">=2026.6.11"
    },
    "build": {
      "openclawVersion": "2026.6.11",
      "pluginSdkVersion": "2026.6.11",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": false
    }
  },
  "files": [
    "dist/**",
    "openclaw.plugin.json",
    "README.md",
    "references/**",
    "scripts/**",
    "skills/**"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:openclaw/plugin-sdk/plugin-entry --external:typebox --outfile=dist/index.js",
    "validate": "clawhub package validate ."
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.11"
  },
  "peerDependenciesMeta": {
    "openclaw": { "optional": true }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DeepSeekOracle/lygo-protocol-stack",
    "directory": "clawhub/packages/lygo-lattice-pulse"
  },
  "keywords": [
    "lygo",
    "lattice",
    "openclaw",
    "haven",
    "p0",
    "star-chart",
    "verification",
    "agent-tools"
  ]
}