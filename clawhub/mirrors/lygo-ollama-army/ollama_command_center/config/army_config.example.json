{
  "name": "LYGO Ollama Army Command Center",
  "signature": "Δ9Φ963-ARMY-CC-v3.1",
  "lygo_stack_root": "",
  "system_profile": {
    "stack_version": "P9-SLM",
    "public_pages": []
  },
  "poll_seconds": 180,
  "army_capacity": {
    "model": "llama3.2:1b",
    "roles": [
      "hb-light",
      "memory-triage",
      "draft-simple",
      "resonance-analyst",
      "lattice-check"
    ],
    "count_per_role": 1,
    "hb_light_instances": 1,
    "champion_egg_boot_instances": 0
  },
  "sentinel": {
    "enabled": true,
    "interval_seconds": 300,
    "alert_on_lattice_fail": true,
    "probe_public_pages": false,
    "probe_network_builder": false,
    "probe_hf_space": false,
    "require_ollama_for_healthy": true
  },
  "paths": {
    "tasks": "tasks",
    "results": "results",
    "logs": "logs",
    "workspace": "workspace"
  },
  "planting": {
    "enabled": false,
    "consent": false,
    "local_only_anchor": true
  },
  "access": {
    "hf_write": false,
    "github_push": false,
    "clawhub_publish": false,
    "workspace_write": true,
    "social_publish": false,
    "remote_llm": false,
    "outbound_webhook": false
  },
  "notifications": {
    "local_alerts_only": true
  },
  "self_tune": {
    "enabled": false,
    "max_queued_tasks": 30,
    "auto_enable_planting": false,
    "pause_planting_on_lattice_fail": true,
    "sync_clawhub_expect_from_stack": false
  },
  "haven_star_chart": {
    "enabled": false,
    "rebuild_on_self_tune": false
  },
  "token_saver": {
    "enabled": false
  },
  "idle_guardian": {
    "enabled": false,
    "allow_planting": false,
    "allow_social_pulse": false,
    "allow_external_memory_write": false,
    "roles": ["hb-light", "lattice-check"],
    "housekeep_ops": ["lattice_light"],
    "forbidden_roles": [
      "egg-planter",
      "registry-planter",
      "moltx-lattice-pulse",
      "moltbook-lyra-pulse",
      "moltbook-lightfather-pulse",
      "discord-triage"
    ]
  }
}
