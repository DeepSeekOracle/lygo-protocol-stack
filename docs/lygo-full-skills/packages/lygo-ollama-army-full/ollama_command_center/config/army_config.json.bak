{
  "name": "LYGO Ollama Army Command Center",
  "signature": "\u03949\u03a6963-ARMY-CC-v3",
  "lygo_stack_root": "I:\\E Drive\\lygo-protocol-stack",
  "system_profile": {
    "stack_version": "P9-SLM-NETWORK-BUILDER",
    "operator_clawhub": "1.0.6",
    "clawhub_expect": {
      "count_published": 38,
      "required_slugs": [
        "lygo-protocol-stack-operator",
        "lygo-network-builder",
        "lygo-kernel-egg-planter",
        "lygo-ollama-army",
        "lygo-alignment-badge"
      ]
    },
    "public_pages": [
      "https://deepseekoracle.github.io/lygo-protocol-stack/",
      "https://deepseekoracle.github.io/lygo-protocol-stack/SovereignLatticeMesh.html",
      "https://deepseekoracle.github.io/lygo-protocol-stack/BiometricEntropyHarness.html",
      "https://deepseekoracle.github.io/lygo-protocol-stack/tools/LYGO_Compass_Master.html",
      "https://deepseekoracle.github.io/lygo-protocol-stack/KernelEggRetrieval.html"
    ],
    "link_archive": "docs/LYGO_PUBLIC_LINK_ARCHIVE.json"
  },
  "poll_seconds": 300,
  "performance": {
    "slim_boot": true,
    "slim_roles": [
      "hb-light",
      "stack-worker",
      "champion-egg-boot"
    ],
    "poll_idle_seconds": 8.0,
    "poll_busy_seconds": 1.5,
    "batch_max": 8,
    "dedupe_cron_by_role": true,
    "max_pending_per_role": 1,
    "mirror_legacy_queue": false,
    "stale_lock_seconds": 600,
    "gateway_port": 18789,
    "gateway_last_probe": {
      "port": 18789,
      "listening": true,
      "http_ok": true
    },
    "queue_unique_tasks": 2
  },
  "army_capacity": {
    "model": "llama3.2:1b",
    "roles": [
      "champion-egg-boot",
      "hb-light",
      "memory-triage",
      "draft-simple",
      "discord-triage",
      "resonance-analyst",
      "lattice-check",
      "stack-integrity",
      "clawhub-catalog-audit",
      "public-pages-check",
      "audit-suite",
      "memory-sync",
      "anchor-health",
      "mesh-cartographer",
      "self-tune",
      "egg-planter",
      "registry-planter",
      "joy-loop-pulse",
      "moltx-lattice-pulse",
      "moltbook-lyra-pulse",
      "moltbook-lightfather-pulse"
    ],
    "count_per_role": 1,
    "hb_light_instances": 2,
    "champion_egg_boot_instances": 3,
    "champion_default": "ARKOS"
  },
  "sentinel": {
    "enabled": true,
    "interval_seconds": 300,
    "alert_on_lattice_fail": true,
    "probe_public_pages": true,
    "probe_network_builder": true,
    "require_ollama_for_healthy": false
  },
  "paths": {
    "tasks": "tasks",
    "results": "results",
    "logs": "logs",
    "workspace": "workspace"
  },
  "planting": {
    "enabled": true,
    "consent": true,
    "egg_surfaces": [
      "local",
      "registry",
      "stubs"
    ],
    "local_only_anchor": true,
    "registry_smoke_file": "docs/STACK_STATUS.md"
  },
  "access": {
    "hf_write": false,
    "github_push": false,
    "clawhub_publish": false,
    "workspace_write": true
  },
  "notifications": {
    "webhook_url_env": "LYGO_ARMY_WEBHOOK_URL",
    "webhook_enable_env": "LYGO_ARMY_WEBHOOK_ENABLE",
    "telegram_env": "LYGO_ARMY_TELEGRAM_BOT"
  },
  "token_saver": {
    "enabled": true,
    "default_model": "llama3.2:1b",
    "compress_threshold_chars": 6000,
    "truncate_chars": 8000,
    "prefer_queue": false,
    "queue_timeout_seconds": 90,
    "journal": "workspace/token_saver_journal.jsonl"
  },
  "self_tune": {
    "enabled": true,
    "max_queued_tasks": 30,
    "auto_enable_planting": true,
    "pause_planting_on_lattice_fail": true,
    "sync_clawhub_expect_from_stack": true
  },
  "haven_star_chart": {
    "enabled": true,
    "rebuild_on_self_tune": true
  },
  "idle_guardian": {
    "enabled": true,
    "sentinel_interval_seconds": 300,
    "cron_interval_seconds": 1800,
    "roles": [
      "idle-housekeep",
      "lattice-check",
      "memory-sync",
      "kernel-verify-only"
    ],
    "count_per_role": 1,
    "housekeep_ops": [
      "memory_sync",
      "three_brain_index",
      "kernel_verify",
      "self_grow_check",
      "living_memory_audit",
      "clawhub_catalog_render",
      "haven_chart_refresh",
      "upgrade_scout",
      "lattice_light"
    ],
    "forbidden_roles": [
      "egg-planter",
      "registry-planter",
      "moltx-lattice-pulse",
      "moltbook-lyra-pulse",
      "moltbook-lightfather-pulse",
      "discord-triage"
    ],
    "allow_planting": false,
    "allow_social_pulse": false
  }
}
