{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lygo.local/schemas/public_verify_manifest.schema.json",
  "title": "LYGO Public Verify Manifest",
  "type": "object",
  "required": ["signature", "created_utc", "layers", "public_endpoints", "user_protection"],
  "properties": {
    "signature": { "type": "string" },
    "created_utc": { "type": "string" },
    "layers": {
      "type": "object",
      "properties": {
        "A_classic": { "type": "object" },
        "B_sovereign": { "type": "object" },
        "C_external": { "type": "object" }
      }
    },
    "public_endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "role"],
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string" },
          "role": { "type": "string" },
          "verify": { "type": "string" }
        }
      }
    },
    "star_chart": { "type": "object" },
    "user_protection": { "type": "object" }
  }
}
